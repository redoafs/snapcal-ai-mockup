# ===== Tautan checkout Lynk.id untuk paket Pro =====
# Isi dengan tautan produk digital Lynk.id Anda, lalu jalankan `npm run build`
# agar terbaca aplikasi.
#
# Tautan umum (dipakai untuk paket yang tautan spesifiknya kosong):
NEXT_PUBLIC_LYNK_URL=https://lynk.id/snapcal-ai/vrgg5vo5dxwz/checkout

# Tautan per paket (opsional; berguna bila Anda membuat produk terpisah untuk
# setiap paket agar harga yang dibayar sesuai dengan paket yang dipilih):
# NEXT_PUBLIC_LYNK_PRO_MONTHLY=
# NEXT_PUBLIC_LYNK_PRO_YEARLY=
# NEXT_PUBLIC_LYNK_PRO_LIFETIME=

# ===== Supabase (database + autentikasi aplikasi) =====
# Aplikasi memakai Supabase Auth sungguhan (sesi berbasis cookie lewat
# @supabase/ssr) dan kunci publishable/anon, sehingga Row Level Security (RLS)
# tetap aktif dan tiap pengguna hanya melihat datanya sendiri.
NEXT_PUBLIC_SUPABASE_URL=https://tahnkykyvfshcglwbzui.supabase.co
SUPABASE_URL=https://tahnkykyvfshcglwbzui.supabase.co

# Kunci publishable/anon (aman dibuka ke browser). Isi dengan milik proyek Anda.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
SUPABASE_ANON_KEY=sb_publishable_xxx

# Akun demo (pengguna Supabase Auth asli). Dipakai untuk masuk di halaman
# /login dan oleh `npm run db:check`.
SUPABASE_DEMO_EMAIL=redo@snapcal.ai
SUPABASE_DEMO_PASSWORD=snapcal-demo-2026

# ===== Deploy ke Netlify =====
# Isi ketiga variabel berikut DI PANEL NETLIFY (Site configuration ->
# Environment variables), dengan nilai yang sama seperti di atas. Karena
# diawali NEXT_PUBLIC_, nilainya dikunci saat BUILD — jadi set dulu, baru
# deploy. Lihat docs/PANDUAN_DEPLOY_NETLIFY.md.
#
#   NEXT_PUBLIC_SUPABASE_URL
#   NEXT_PUBLIC_SUPABASE_ANON_KEY
#   NEXT_PUBLIC_LYNK_URL
