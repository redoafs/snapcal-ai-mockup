# ===== Tautan checkout Lynk.id untuk paket Pro =====
# Isi dengan tautan produk digital Lynk.id Anda, lalu jalankan `npm run build`
# agar terbaca aplikasi.
#
# Tautan umum (dipakai untuk paket yang tautan spesifiknya kosong):
NEXT_PUBLIC_LYNK_URL=https://lynk.id/username

# Tautan per paket (opsional, memudahkan pelacakan penjualan):
NEXT_PUBLIC_LYNK_PRO_MONTHLY=https://lynk.id/username/pro-bulanan
NEXT_PUBLIC_LYNK_PRO_YEARLY=https://lynk.id/username/pro-tahunan
NEXT_PUBLIC_LYNK_PRO_LIFETIME=https://lynk.id/username/pro-lifetime
